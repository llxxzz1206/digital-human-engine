# ── LLM 配置（GLM-4-Flash）──
LLM__PROVIDER=zhipu
LLM__MODEL=glm-4-flash
LLM__FAST_MODEL=
LLM__API_KEY=your-zhipu-api-key-here
LLM__API_BASE=https://open.bigmodel.cn/api/paas/v4/

# ── ASR 配置 ──
ASR__PROVIDER=whisper
ASR__MODEL=small
ASR__DEVICE=cpu
ASR__HOTWORDS=

# ── TTS 配置 ──
TTS__APP_ID=your-xunfei-app-id
TTS__API_KEY=your-xunfei-api-key
TTS__API_SECRET=your-xunfei-api-secret
TTS__VOICE=x4_lingxiaoxuan_oral
TTS__SPEED=50

# ── RAG 配置 ──
RAG__RERANK_ENABLED=false
RAG__RERANK_MODEL=qwen3-rerank
RAG__RERANK_THRESHOLD_A=0.70
RAG__RERANK_THRESHOLD_B=0.4
RAG__RERANK_NOISE_THRESHOLD=0.10
RAG__FAQ_ENABLED=true
RAG__FAQ_DIRECT_THRESHOLD=0.70
RAG__FAQ_PROMOTION_THRESHOLD=5
RAG__FAQ_SIMILARITY_THRESHOLD=0.92
RAG__CONTEXT_WINDOW=40
RAG__TOP_K=3

# ── Redis 配置 ──
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__PASSWORD=
REDIS__DB=0

# ── Milvus 配置 ──
MILVUS__HOST=localhost
MILVUS__PORT=19530

# ── PostgreSQL 配置 ──
DATABASE__URL=postgresql://postgres:postgres@localhost:5432/digital_human

# ── RocketMQ 配置（可选，不安装 rocketmq-client-python 则自动禁用）──
ROCKETMQ__NAMESRV_ADDR=localhost:9876
ROCKETMQ__TOPIC=knowledge-build-topic
ROCKETMQ__CONSUMER_GROUP=knowledge-build-consumer

# ── WebSocket 安全配置 ──
WEBSOCKET_TOKEN=

# ── Admin API 安全配置 ──
ADMIN_TOKEN=

# ── CORS 配置 ──
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── 日志级别 ──
LOG_LEVEL=INFO
